unit Digests;

{ Checksum list formats (writing and tolerant reading). Shared by the Checksums area, the MD5 check and the checksum
  program the Checksums area makes, so: Windows + System only (no SysUtils). Delphi and Free Pascal. }

{$IFDEF FPC}{$mode delphiunicode}{$H+}{$ENDIF}

interface

uses
  Windows, Hashes;

type
  TDigestFormat = (dfMD5Sum, dfSHA1Sum, dfSFV, dfFileCheckMD5, dfFSum);

  TDigestEntry = record
    Name: string;      // relative path, backslash separated
    Hash: TDigest;
  end;
  TDigestEntries = array of TDigestEntry;

const
  FormatNames: array[TDigestFormat] of string = ('md5sum', 'sha1sum', 'sfv',
    'FileCheckMD5', 'fsum');

function FormatSupports(F: TDigestFormat; A: THashAlgo): Boolean;
function FormatExtension(F: TDigestFormat; A: THashAlgo): string;
function DigestHeader(F: TDigestFormat; A: THashAlgo; const Generator: string): string;
{ md5sum/sha1sum files use LF (GNU tools choke on CR); the Windows formats use CRLF. }
function DigestEOL(F: TDigestFormat): string;
function DigestLine(F: TDigestFormat; A: THashAlgo; const RelName: string; const D: TDigest): string;

{ Decode a digest file's bytes (UTF-8, falling back to the ANSI code page). }
function DecodeText(const Data: RawByteString): string;
function EncodeUtf8(const S: string): RawByteString;

{ Tolerant parser: md5sum/sha1sum/fsum/FileCheckMD5 "hash *name", BSD
  "ALGO (name) = hash" and SFV "name hash" lines; ';' and '#' comments. }
function ParseDigest(const Text: string; A: THashAlgo; out Entries: TDigestEntries): Integer;

{ The algorithm a checksum list holds: from its extension (.md5, .sha1, .sfv = CRC32, or an algorithm's name such as
  .sha256 or .tiger192), else from an fsum-style '; Algorithm: X' line in Text. False if neither says. }
function ListAlgorithm(const FileName, Text: string; out A: THashAlgo): Boolean;

implementation

function FormatSupports(F: TDigestFormat; A: THashAlgo): Boolean;
begin
  case F of
    dfMD5Sum, dfFileCheckMD5: Result := A = haMD5;
    dfSHA1Sum: Result := A = haSHA1;
    dfSFV: Result := A = haCRC32;
  else
    Result := True;
  end;
end;

function LowerAscii(const S: string): string;
var I: Integer;
begin
  Result := S;
  for I := 1 to Length(Result) do
    if (Result[I] >= 'A') and (Result[I] <= 'Z') then Result[I] := Char(Ord(Result[I]) + 32);
end;

function FormatExtension(F: TDigestFormat; A: THashAlgo): string;
begin
  case F of
    dfMD5Sum, dfFileCheckMD5: Result := 'md5';
    dfSHA1Sum: Result := 'sha1';
    dfSFV: Result := 'sfv';
  else
    Result := LowerAscii(HashNames[A]);
  end;
end;

function DigestEOL(F: TDigestFormat): string;
begin
  if F in [dfMD5Sum, dfSHA1Sum] then Result := #10 else Result := #13#10;
end;

function DigestHeader(F: TDigestFormat; A: THashAlgo; const Generator: string): string;
begin
  case F of
    dfMD5Sum, dfSHA1Sum: Result := '';
    dfSFV: Result := '; Generated by ' + Generator + #13#10';' + #13#10;
    dfFileCheckMD5: Result := '; Generated by ' + Generator + #13#10';' + #13#10;
  else
    Result := '; Generated by ' + Generator + #13#10 + '; Algorithm: ' + HashNames[A] + #13#10';' + #13#10;
  end;
end;

function Slashes(const S: string; From, To_: Char): string;
var I: Integer;
begin
  Result := S;
  for I := 1 to Length(Result) do
    if Result[I] = From then Result[I] := To_;
end;

function UpperHex(const S: string): string;
var I: Integer;
begin
  Result := S;
  for I := 1 to Length(Result) do
    if (Result[I] >= 'a') and (Result[I] <= 'z') then Result[I] := Char(Ord(Result[I]) - 32);
end;

function DigestLine(F: TDigestFormat; A: THashAlgo; const RelName: string; const D: TDigest): string;
var Hex: string;
begin
  Hex := DigestToHex(D);
  case F of
    dfMD5Sum: Result := Hex + '  ' + Slashes(RelName, '\', '/');
    dfSHA1Sum: Result := Hex + ' *' + Slashes(RelName, '\', '/');
    dfSFV: Result := Slashes(RelName, '/', '\') + ' ' + UpperHex(Hex);
  else
    Result := Hex + ' *' + Slashes(RelName, '/', '\');
  end;
end;

function EncodeUtf8(const S: string): RawByteString;
var N: Integer;
begin
  Result := '';
  if S = '' then Exit;
  N := WideCharToMultiByte(CP_UTF8, 0, PWideChar(S), Length(S), nil, 0, nil, nil);
  SetLength(Result, N);
  WideCharToMultiByte(CP_UTF8, 0, PWideChar(S), Length(S), PAnsiChar(Result), N, nil, nil);
end;

function DecodeText(const Data: RawByteString): string;
var
  N, Start: Integer;
begin
  Result := '';
  if Data = '' then Exit;
  Start := 1;
  if (Length(Data) >= 3) and (Data[1] = #$EF) and (Data[2] = #$BB) and (Data[3] = #$BF) then
    Start := 4;
  N := MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, @Data[Start], Length(Data) - Start + 1, nil, 0);
  if N > 0 then
  begin
    SetLength(Result, N);
    MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, @Data[Start], Length(Data) - Start + 1, PWideChar(Result), N);
  end
  else
  begin
    N := MultiByteToWideChar(CP_ACP, 0, @Data[Start], Length(Data) - Start + 1, nil, 0);
    SetLength(Result, N);
    if N > 0 then
      MultiByteToWideChar(CP_ACP, 0, @Data[Start], Length(Data) - Start + 1, PWideChar(Result), N);
  end;
end;

function IsHex(C: Char): Boolean; inline;
begin
  Result := ((C >= '0') and (C <= '9')) or ((C >= 'a') and (C <= 'f')) or ((C >= 'A') and (C <= 'F'));
end;

function AllHex(const S: string; From, Count: Integer): Boolean;
var I: Integer;
begin
  Result := False;
  if (From < 1) or (From + Count - 1 > Length(S)) then Exit;
  for I := From to From + Count - 1 do
    if not IsHex(S[I]) then Exit;
  Result := True;
end;

function TrimWS(const S: string): string;
var A, B: Integer;
begin
  A := 1;
  B := Length(S);
  while (A <= B) and ((S[A] <= ' ') or (S[A] = #$FEFF)) do Inc(A);
  while (B >= A) and (S[B] <= ' ') do Dec(B);
  Result := Copy(S, A, B - A + 1);
end;

function CleanName(const S: string): string;
var I: Integer;
begin
  Result := S;
  for I := 1 to Length(Result) do
    if Result[I] = '/' then Result[I] := '\';
  while (Length(Result) > 2) and (Result[1] = '.') and (Result[2] = '\') do
    Delete(Result, 1, 2);
end;

function ParseLine(const Line: string; A: THashAlgo; out Name: string; out D: TDigest): Boolean;
var
  HL, P, Q: Integer;
  HexStr: string;
begin
  Result := False;
  HL := HashDigestBytes[A] * 2;
  if (Line = '') or (Line[1] = ';') or (Line[1] = '#') then Exit;

  // BSD style:  ALGO (name) = hash
  P := Pos(' (', Line);
  if (P > 1) and (Length(Line) > HL + 4) and (Copy(Line, Length(Line) - HL - 3, 4) = ') = ') then
    if AllHex(Line, Length(Line) - HL + 1, HL) then
    begin
      // the name runs from after ' (' up to the ')' of ') = ' (the Checksum Applet Creator lost its last character)
      Name := Copy(Line, P + 2, Length(Line) - HL - 4 - (P + 2) + 1);
      HexStr := Copy(Line, Length(Line) - HL + 1, HL);
      Result := HexToDigest(HexStr, D) and (Name <> '');
      if Result then Name := CleanName(Name);
      Exit;
    end;

  // hash first:  hash<sp>[*]name
  if AllHex(Line, 1, HL) and (Length(Line) > HL) and
     ((Line[HL + 1] = ' ') or (Line[HL + 1] = #9) or (Line[HL + 1] = '*')) then
  begin
    P := HL + 1;
    while (P <= Length(Line)) and ((Line[P] = ' ') or (Line[P] = #9)) do Inc(P);
    if (P <= Length(Line)) and (Line[P] = '*') then Inc(P);
    Name := Copy(Line, P, MaxInt);
    HexStr := Copy(Line, 1, HL);
    Result := HexToDigest(HexStr, D) and (Name <> '');
    if Result then Name := CleanName(Name);
    Exit;
  end;

  // name first:  name<sp>hash  (SFV)
  if (Length(Line) > HL + 1) and AllHex(Line, Length(Line) - HL + 1, HL) then
  begin
    Q := Length(Line) - HL;
    if (Line[Q] = ' ') or (Line[Q] = #9) then
    begin
      Name := TrimWS(Copy(Line, 1, Q));
      HexStr := Copy(Line, Q + 1, HL);
      Result := HexToDigest(HexStr, D) and (Name <> '');
      if Result then Name := CleanName(Name);
    end;
  end;
end;

function ParseDigest(const Text: string; A: THashAlgo; out Entries: TDigestEntries): Integer;
var
  I, Start, N: Integer;
  Line, Name: string;
  D: TDigest;

  procedure Take;
  begin
    Line := TrimWS(Copy(Text, Start, I - Start));
    if ParseLine(Line, A, Name, D) then
    begin
      if N = Length(Entries) then SetLength(Entries, N * 2 + 64);
      Entries[N].Name := Name;
      Entries[N].Hash := D;
      Inc(N);
    end;
  end;

begin
  N := 0;
  Entries := nil;
  Start := 1;
  I := 1;
  while I <= Length(Text) do
  begin
    if (Text[I] = #10) or (Text[I] = #13) then
    begin
      Take;
      Start := I + 1;
    end;
    Inc(I);
  end;
  if Start <= Length(Text) then Take;
  SetLength(Entries, N);
  Result := N;
end;

function ListAlgorithm(const FileName, Text: string; out A: THashAlgo): Boolean;
const
  Key = '; algorithm:';
var
  I, Start: Integer;
  Ext, Line: string;
begin
  Result := False;
  A := haMD5;
  Ext := '';
  for I := Length(FileName) downto 1 do
    if FileName[I] = '.' then
    begin
      Ext := LowerAscii(Copy(FileName, I + 1, MaxInt));
      Break;
    end
    else if (FileName[I] = '\') or (FileName[I] = '/') then Break;
  if Ext = 'md5' then begin A := haMD5; Exit(True); end;
  if Ext = 'sha1' then begin A := haSHA1; Exit(True); end;
  if Ext = 'sfv' then begin A := haCRC32; Exit(True); end;
  if (Ext <> '') and HashAlgoByName(Ext, A) then Exit(True);
  // fsum header, as DigestHeader writes it
  Start := 1;
  for I := 1 to Length(Text) + 1 do
    if (I > Length(Text)) or (Text[I] = #10) or (Text[I] = #13) then
    begin
      Line := TrimWS(Copy(Text, Start, I - Start));
      if LowerAscii(Copy(Line, 1, Length(Key))) = Key then
        Exit(HashAlgoByName(TrimWS(Copy(Line, Length(Key) + 1, MaxInt)), A));
      Start := I + 1;
    end;
end;

end.
