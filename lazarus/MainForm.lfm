object FormMain: TFormMain
  Left = 400
  Height = 540
  Top = 200
  Width = 860
  Caption = 'Offline Backup'
  ClientHeight = 540
  ClientWidth = 860
  Constraints.MinHeight = 420
  Constraints.MinWidth = 680
  Position = poScreenCenter
  OnCloseQuery = FormCloseQuery
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  LCLVersion = '4.4.0.0'
  object StatusBar: TStatusBar
    SimplePanel = False
    Left = 0
    Height = 23
    Top = 517
    Width = 860
    Panels = <
      item
        Width = 600
      end
      item
        Width = 200
      end>
  end
  object PanelBackup: TPanel
    Left = 0
    Height = 517
    Top = 0
    Width = 860
    Align = alClient
    BevelOuter = bvNone
    TabOrder = 0
    object PanelBackupActions: TPanel
      Left = 710
      Height = 517
      Top = 0
      Width = 150
      Align = alRight
      BevelOuter = bvNone
      TabOrder = 1
      object ButtonStart: TButton
        Left = 8
        Height = 56
        Top = 34
        Width = 130
        Caption = 'Start copy'
        Enabled = False
        Font.Height = -15
        Font.Style = [fsBold]
        ParentFont = False
        OnClick = ButtonStartClick
        TabOrder = 0
      end
      object ButtonCancel: TButton
        Left = 8
        Height = 30
        Top = 98
        Width = 130
        Caption = 'Cancel'
        Enabled = False
        OnClick = ButtonCancelClick
        TabOrder = 1
      end
      object ButtonDismount: TButton
        Left = 8
        Height = 30
        Top = 136
        Width = 130
        Caption = 'Dismount'
        Visible = False
        OnClick = ButtonDismountClick
        TabOrder = 2
      end
    end
    object PageBackup: TPageControl
      Left = 8
      Height = 501
      Top = 8
      Width = 702
      BorderSpacing.Left = 8
      BorderSpacing.Top = 8
      BorderSpacing.Bottom = 8
      ActivePage = TabDrivesIn
      Align = alClient
      TabOrder = 0
      object TabDrivesIn: TTabSheet
        Caption = 'Drives plugged in'
        object LabelDrives: TLabel
          Left = 6
          Height = 15
          Top = 8
          Width = 682
          BorderSpacing.Left = 6
          BorderSpacing.Top = 8
          BorderSpacing.Right = 6
          BorderSpacing.Bottom = 6
          Align = alTop
          Caption = 'Looking for OFFLINE-x drives ...'
          WordWrap = True
        end
        object ListDrives: TListView
          Left = 6
          Height = 430
          Top = 29
          Width = 682
          BorderSpacing.Left = 6
          BorderSpacing.Right = 6
          BorderSpacing.Bottom = 6
          Align = alClient
          Columns = <
            item
              Caption = 'Drive'
              Width = 44
            end
            item
              Caption = 'Name'
              Width = 150
            end
            item
              Caption = 'What it is for'
              Width = 200
            end
            item
              AutoSize = True
              Caption = 'Last copy'
            end>
          ReadOnly = True
          RowSelect = True
          TabOrder = 0
          ViewStyle = vsReport
        end
      end
      object TabProgress: TTabSheet
        Caption = 'Progress'
        object LabelStatus: TLabel
          Left = 12
          Height = 15
          Top = 14
          Width = 670
          Anchors = [akTop, akLeft, akRight]
          AutoSize = False
          Caption = 'Nothing running.'
          Font.Style = [fsBold]
          ParentFont = False
        end
        object LabelEta: TLabel
          Left = 12
          Height = 15
          Top = 42
          Width = 670
          Anchors = [akTop, akLeft, akRight]
          AutoSize = False
          Caption = ''
        end
        object LabelCounts: TLabel
          Left = 12
          Height = 15
          Top = 62
          Width = 670
          Anchors = [akTop, akLeft, akRight]
          AutoSize = False
          Caption = ''
        end
        object LabelRate: TLabel
          Left = 12
          Height = 15
          Top = 82
          Width = 670
          Anchors = [akTop, akLeft, akRight]
          AutoSize = False
          Caption = ''
        end
        object ProgressBar: TProgressBar
          Left = 12
          Height = 22
          Top = 110
          Width = 670
          Anchors = [akTop, akLeft, akRight]
          TabOrder = 0
        end
      end
      object TabLog: TTabSheet
        Caption = 'Log'
        object MemoLog: TMemo
          Left = 6
          Height = 459
          Top = 6
          Width = 682
          BorderSpacing.Left = 6
          BorderSpacing.Top = 6
          BorderSpacing.Right = 6
          BorderSpacing.Bottom = 6
          Align = alClient
          ReadOnly = True
          ScrollBars = ssAutoVertical
          TabOrder = 0
        end
      end
    end
  end
  object TrayIcon: TTrayIcon
    OnClick = TrayIconClick
    PopUpMenu = TrayMenu
    Left = 480
    Top = 40
  end
  object Md5Dialog: TOpenDialog
    DefaultExt = 'md5'
    Filter = 'MD5 files (*.md5)|*.md5|All files (*.*)|*.*'
    Options = [ofPathMustExist, ofFileMustExist, ofEnableSizing]
    Title = 'Check the files listed in an MD5 file'
    Left = 360
    Top = 40
  end
  object TrayMenu: TPopupMenu
    Left = 420
    Top = 40
    object MenuShow: TMenuItem
      Caption = 'Show'
      Default = True
      OnClick = MenuShowClick
    end
    object MenuStart: TMenuItem
      Caption = 'Start copy'
      Enabled = False
      OnClick = ButtonStartClick
    end
    object MenuSettings: TMenuItem
      Caption = 'Settings...'
      OnClick = MenuSettingsClick
    end
    object MenuCheck: TMenuItem
      Caption = 'Check MD5 file...'
      OnClick = MenuCheckClick
    end
    object MenuDrives: TMenuItem
      Caption = 'Drives...'
      OnClick = MenuDrivesClick
    end
    object MenuDismount: TMenuItem
      Caption = 'Dismount'
      Visible = False
      OnClick = ButtonDismountClick
    end
    object MenuSep: TMenuItem
      Caption = '-'
    end
    object MenuExit: TMenuItem
      Caption = 'Exit'
      OnClick = MenuExitClick
    end
  end
end
