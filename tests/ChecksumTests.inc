  Want: array[THashAlgo, 0..1] of string = (
    ('2a8daa60ccafb890716187ef4c05c518', '538906e094d1e8e7eae5eaebdfffc6a8'),
    ('364bce676d1bcb45b92de5ed53631274', 'b1be387c41dc5e3f43fb023454e90970'),
    ('a97923fa0427fb6f1bab0cbe8434baae', '44165905e498d98e27cc3d33e4942788'),
    ('ca636ae55d39a847a07b084f3f9abde66ec9f27a', 'e6f771537171c3e717f292681e1ff9ab69244ad2'),
    ('8d130d5d4dbbd61247fc18a56d5f281837a234671a74353df016fb1230c77fca',
     'd2c009b91732d81444fa21e79fd2415e7f669126f531ad84a86695fb71161b36'),
    ('67464a7c0e6f862caebf4f0cbdf88c5a238c8de8341da1de228b68f1c7574cac736d17488080baaf4fbcee59b71a0ac7',
     'db987f1b8d262f921014ada9cc8db17ce94ac5818ffee66df26a3edb3b85ff30764c4d6ad45eee971f81dcee1d315850'),
    ('06bac6f98f468f6a1bf2aa0d9aae70b4e0362ed5a940d542f9737b38dfee052f' +
     '1340b81a189144040ae0829f5ecc65cf03869f002c94d0c0c5b3975c3e55e0e1',
     'ada4db7fb26c3078006ea075bda72d63afc988e96c43da8729d5131bd49b8f01' +
     'fc047808326375a4769848073eea61fc83b25f0c578b00a77c846d3a024b0a9b'),
    ('ffa53e35', '68efcad0'),
    ('653b3e93', 'f93ed6ff'),
    ('31b6f70b49a487a3edb88ffdf1406155cd511bfda3c9c8afc2e4964f8dc659d4',
     '0c4ca3a308f6e69d31a45c592ffb710f5df12c0e97e4b4c9e676c522c9d96a11'),
    ('9092375d59d72a5917d4e1b07fbe4797', '7e6256930dec8ed7bcb3f915ce612163'),
    ('ceff06fdb66fb88ab686a7a58a848f9123c8b1b7', 'ff57e74678f810bd30f8a5651ae8a63fa7c716e1'),
    ('523ddbbeec547795fb93c730315a7dbd', 'ef544dc007f7740b9b32fc5b52fb0e50'),
    ('523ddbbeec547795fb93c730315a7dbd9488bedf', 'ef544dc007f7740b9b32fc5b52fb0e50a69fd330'),
    ('523ddbbeec547795fb93c730315a7dbd9488bedfee021ce7', 'ef544dc007f7740b9b32fc5b52fb0e50a69fd33047e2da6f'));
var
  A: THashAlgo;
  Got1, Got2: string;
begin
  WriteLn('--- hash algorithms (Checksums area)');
  for A := Low(THashAlgo) to High(THashAlgo) do
  begin
    Got1 := HashOf(A, Pattern(129), 2);
    Got2 := HashOf(A, Pattern(100000), 4093);
    Check((Got1 = Want[A, 0]) and (Got2 = Want[A, 1]), HashNames[A] + ' matches the checked results (' + Got1 + ')');
  end;
  Check(HashOf(haSHA256, 'abc', 1) = 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad',
    'SHA256 of "abc"');
  Check(HashOf(haCRC32, '123456789', 3) = 'cbf43926', 'CRC32 of "123456789"');
end;

procedure TestListFormats;
var
  A: THashAlgo;
  E: TDigestEntries;
  D: TDigest;
begin
  WriteLn('--- checksum list formats');
  Check(ListAlgorithm('x\a.md5', '', A) and (A = haMD5), '.md5 is MD5');
  Check(ListAlgorithm('x\a.SHA256', '', A) and (A = haSHA256), '.SHA256 is SHA256');
  Check(ListAlgorithm('a.sfv', '', A) and (A = haCRC32), '.sfv is CRC32');
  Check(ListAlgorithm('a.tiger192', '', A) and (A = haTiger192), '.tiger192 is TIGER192');
  Check(ListAlgorithm('a.txt', '; Generated by x'#13#10'; Algorithm: RIPEMD160'#13#10, A) and (A = haRIPEMD160),
    'an fsum header names the algorithm');
  Check(not ListAlgorithm('a.txt', 'no header', A), 'an unknown list is refused');
  Check(not ListAlgorithm('my.folder\list', '', A), 'a dot in a folder name is not an extension');
  HexToDigest('900150983cd24fb0d6963f7d28e17f72', D);
  Check(DigestLine(dfMD5Sum, haMD5, 'sub\a b.txt', D) = '900150983cd24fb0d6963f7d28e17f72  sub/a b.txt',
    'md5sum line uses / and two spaces');
  Check(DigestLine(dfFSum, haMD5, 'sub\a.txt', D) = '900150983cd24fb0d6963f7d28e17f72 *sub\a.txt', 'fsum line');
  Check(ParseDigest('MD5 (sub/a b.txt) = 900150983cd24fb0d6963f7d28e17f72'#10'; comment'#10 +
    '900150983cd24fb0d6963f7d28e17f72 *./c.txt'#10, haMD5, E) = 2, 'BSD and binary lines read');
  Check((E[0].Name = 'sub\a b.txt') and (E[1].Name = 'c.txt') and DigestsEqual(E[0].Hash, D),
    '... with the names cleaned up');
  Check((ParseDigest('dir\file one.txt CBF43926'#13#10, haCRC32, E) = 1) and (E[0].Name = 'dir\file one.txt'),
    'an SFV line is read');
  Check(NormalizeBaseName('  Check Me.exe ') = 'Check Me', 'the program name loses .exe');
  Check(NormalizeBaseName('') = DefaultBaseName, 'an empty name is checksum');
  Check(NormalizeBaseName('a:b') = '', 'a name with : is refused');
  Check(IsMakerOutput('checksum.SHA256', 'checksum') and IsMakerOutput('checksum.exe', 'checksum') and
    not IsMakerOutput('sub\checksum.md5', 'checksum') and not IsMakerOutput('checksum.txt', 'checksum'),
    'the list''s own earlier output is recognised');
end;

function MakeList(const O: TMakeOptions; const Stub: string): TChecksumJob;
begin
  Result := TChecksumJob.Create(O, ScanFolder(O.Folder, True, O.BaseName));
  Result.StubFile := Stub;
  Result.Run;
end;

{ The CHKCFG resource of a checksum program, '' if it has none }
function ProgramConfig(const Exe: string): string;
var
  M: HMODULE;
  R: HRSRC;
  P: PAnsiChar;
  Raw: RawByteString;
begin
  Result := '';
  M := LoadLibraryExW(PWideChar(Exe), 0, LOAD_LIBRARY_AS_DATAFILE);
  if M = 0 then Exit;
  try
    R := FindResourceW(M, 'CHKCFG', PWideChar(RT_RCDATA));
    if R = 0 then Exit;
    P := LockResource(LoadResource(M, R));
    SetString(Raw, P, SizeofResource(M, R));
    Result := DecodeText(Raw);
  finally
    FreeLibrary(M);
  end;
end;

procedure TestMakeLists;
var
  Dir, Ico: string;
  O: TMakeOptions;
  J: TChecksumJob;
  Items: TCheckItems;
  L: TMakeFiles;
  R: TCopyResult;
  Report: string;
begin
  WriteLn('--- Checksums area: make a list, then check it');
  Dir := Work + 'lists\';
  WriteFile(Dir + 'a.txt', 'alpha');
  WriteFile(Dir + 'sub\b.txt', 'bravo');
  WriteFileW(Dir + 'sub\' + Uni, 'non-ANSI');
  ForceDirectories(Dir + 'empty');
  L := ScanFolder(Dir, False, 'checksum');
  Check(Length(L) = 1, 'without subfolders: 1 file');
  L := ScanFolder(Dir, True, 'checksum');
  Check((Length(L) = 3) and (L[0].RelName = 'a.txt') and (L[1].RelName = 'sub\b.txt'), 'with subfolders: 3, sorted');

  O := Default(TMakeOptions);
  O.Folder := Dir;
  O.BaseName := 'checksum';
  O.Algo := haSHA256;
  O.Format := dfFSum;
  J := MakeList(O, '');
  try
    Check((J.Outcome = mkDone) and (J.ListPath = Dir + 'checksum.sha256') and (J.BytesDone = J.BytesTotal),
      'SHA256 list written (' + J.ErrorText + ')');
  finally
    J.Free;
  end;
  Check(Length(ScanFolder(Dir, True, 'checksum')) = 3, 'a new scan leaves the list out');
  R := RunCheckMd5(Dir + 'checksum.sha256', Items);
  Check((R = crOk) and (Length(Items) = 3) and (CountStatus(Items, csOk) = 3), 'the MD5 check page checks it: all ok');
  WriteFile(Dir + 'a.txt', 'changed');
  R := RunCheckMd5(Dir + 'checksum.sha256', Items);
  Check((R = crFailed) and (Items[0].Status = csBad) and (CountStatus(Items, csOk) = 2),
    '... and finds a changed file');
  Report := CheckReportText(Dir + 'checksum.sha256', haSHA256, Items, R);
  Check((Pos('PROBLEMS WERE FOUND - 1 file(s)', Report) > 0) and (Pos('FAILED'#9'SHA256'#9'a.txt', Report) > 0) and
    (Pos('OK'#9'SHA256'#9'sub\' + Uni, Report) > 0), 'the text report lists the problem and every file');

  O.Algo := haCRC32;
  O.Format := dfSFV;
  J := MakeList(O, '');
  try
    Check((J.Outcome = mkDone) and FileExists(Dir + 'checksum.sfv'), 'SFV list written');
  finally
    J.Free;
  end;
  R := RunCheckMd5(Dir + 'checksum.sfv', Items);
  Check((R = crOk) and (Length(Items) = 3), 'the SFV list checks out');

  O.Algo := haMD5;
  O.Format := dfMD5Sum;
  J := MakeList(O, '');
  J.Free;
  R := RunCheckMd5(Dir + 'checksum.md5', Items);
  Check((R = crOk) and (Length(Items) = 3), 'an md5sum list checks out');
  Check(Pos('sub/b.txt', ReadUtf8(Dir + 'checksum.md5')) > 0, '... and uses forward slashes');

  O.Format := dfSHA1Sum;
  J := MakeList(O, '');
  try
    Check((J.Outcome = mkFailed) and not FileExists(Dir + 'checksum.sha1'), 'sha1sum format refuses MD5 checksums');
  finally
    J.Free;
  end;

  // the checksum program: this test exe stands in for the real one, with a tiny made-up icon
  Ico := Work + 'test.ico';
  WriteFileW(Ico, AnsiString(#0#0#1#0#1#0 + #16#16#0#0#1#0#32#0 + #4#0#0#0 + #22#0#0#0 + 'ICON'));
  O.Format := dfFSum;
  O.Algo := haTiger192;
  O.BaseName := 'Check Me';
  O.MakeProgram := True;
  O.IconFile := Ico;
  J := MakeList(O, ParamStr(0));
  try
    Check((J.Outcome = mkDone) and (J.ExePath = Dir + 'Check Me.exe'),
      'checksum program written (' + J.ErrorText + ')');
  finally
    J.Free;
  end;
  Check(Pos('digest=Check Me.tiger192'#13#10'algo=TIGER192', ProgramConfig(Dir + 'Check Me.exe')) > 0,
    '... with its configuration in it');
  Check(Pos('created=' + FormatDateTime('yyyy"-"mm"-"dd', Now), ProgramConfig(Dir + 'Check Me.exe')) > 0,
    '... including when the list was made');
  // 3 files + the 3 checksum.* lists made above (only Check Me's own output is left out)
  Check(Length(ScanFolder(Dir, True, 'Check Me')) = 6, 'a new scan leaves the program and its list out');
  O.IconFile := Dir + 'a.txt';
  J := MakeList(O, ParamStr(0));
  try
    Check((J.Outcome = mkFailed) and (Pos('icon', J.ErrorText) > 0), 'a file that is not an icon is refused');
  finally
    J.Free;
  end;
  SysUtils.DeleteFile(Dir + 'Check Me.exe');
  O.IconFile := '';
  J := MakeList(O, '');
  try
    Check((J.Outcome = mkFailed) and not FileExists(Dir + 'Check Me.exe'),
      'no program is left behind when there is none to copy (' + J.ErrorText + ')');
  finally
    J.Free;
  end;
  WriteFile(Dir + 'odd.xyz', '900150983cd24fb0d6963f7d28e17f72 *a.txt');
  R := RunCheckMd5(Dir + 'odd.xyz', Items);
  Check((R = crFailed) and (Length(Items) = 0), 'a list of unknown type is refused');
end;
