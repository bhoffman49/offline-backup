{ Tests for the Checksums area: Hashes, Digests and Checksums, and the MD5 check reading other lists.
  Included by EngineTest.dpr (uses its Check, Work, Uni and file helpers). }

// the bytes HashTest of the Checksum Applet Creator hashes: its results were checked against GnuPG (libgcrypt)
function Pattern(N: Integer): RawByteString;
var
  I: Integer;
begin
  SetLength(Result, N);
  for I := 1 to N do Result[I] := AnsiChar((I * 7 + I div 3 + 11) and 255);
end;

function HashOf(A: THashAlgo; const S: RawByteString; Chunk: Integer): string;
var
  Hs: THasher;
  D: TDigest;
  P, N: Integer;
begin
  Hs := NewHasher(A);
  try
    P := 1;
    while P <= Length(S) do
    begin
      N := Chunk;
      if N > Length(S) - P + 1 then N := Length(S) - P + 1;
      Hs.Update(@S[P], N);
      Inc(P, N);
    end;
    Hs.Final(D);
  finally
    Hs.Free;
  end;
  Result := DigestToHex(D);
end;

