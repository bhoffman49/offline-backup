{ Tests for reading several files at once (HashThreads, 0.12): the Checksum Applet's list making, the MD5 check page
  and the checksum program give the same results - in the same order - with one worker and with several, also with
  missing, changed and unreadable files and when cancelled. Included by EngineTest.dpr after ChecksumTests.inc (uses
  its Pattern and MakeList). StubExe: the built checksum program (run-tests.cmd passes it), '' to skip its part. }

const
  ParFiles = 300;
  ManyThreads = 8;

var
  StubExe: string;

function ParName(I: Integer): string;
begin
  if I = 77 then Result := 'p\' + Uni
  else Result := 'p\d' + IntToStr(I mod 7) + '\f' + IntToStr(I) + '.bin';
end;

{ 300 files of different sizes (empty ones, 1 MB + a bit to cross a read, and a few of 3 MB) in Dir\p }
procedure MakeParFiles(const Dir: string);
var
  I, N: Integer;
  S: RawByteString;
begin
  for I := 0 to ParFiles - 1 do
  begin
    if I mod 50 = 0 then N := 3 * 1024 * 1024 + I
    else if I mod 37 = 0 then N := 0
    else if I mod 23 = 0 then N := 1024 * 1024 + 1
    else N := (I * 7919) mod 200000;
    S := Pattern(N);
    if N > 0 then S[1 + I mod N] := AnsiChar(I and 255);    // so no two files are the same
    ForceDirectories(ExtractFileDir(Dir + ParName(I)));
    WriteFileW(Dir + ParName(I), AnsiString(S));
  end;
end;

// opens a file so that nobody else can open it (an unreadable file); CloseHandle it after
function LockOut(const Path: string): THandle;
begin
  Result := CreateFileW(PWideChar(Path), GENERIC_READ, 0, nil, OPEN_EXISTING, 0, 0);
end;

// a list's text without its '; Generated by ...' line (it has the time in it)
function ListBody(const Path: string): string;
var
  L: TStringList;
  I: Integer;
begin
  L := TStringList.Create;
  try
    L.Text := ReadUtf8(Path);
    for I := L.Count - 1 downto 0 do
      if Copy(L[I], 1, 15) = '; Generated by ' then L.Delete(I);
    Result := L.Text;
  finally
    L.Free;
  end;
end;

// text without the lines containing Drop (the times and thread counts that may differ between two runs)
function WithoutLines(const Text, Drop: string): string;
var
  L: TStringList;
  I: Integer;
begin
  L := TStringList.Create;
  try
    L.Text := Text;
    for I := L.Count - 1 downto 0 do
      if Pos(Drop, L[I]) > 0 then L.Delete(I);
    Result := L.Text;
  finally
    L.Free;
  end;
end;

function MakeListWith(Threads: Integer; const O: TMakeOptions; out Body: string): TChecksumJob;
begin
  HashThreadsOverride := Threads;
  SysUtils.DeleteFile(O.Folder + ListFileName(O));
  Result := MakeList(O, '');
  Body := '';
  if Result.ListPath <> '' then Body := ListBody(Result.ListPath);
  HashThreadsOverride := 0;
end;

procedure TestParallelLists(const Dir: string);
const
  Algos: array[0..3] of THashAlgo = (haMD5, haSHA256, haCRC32, haTiger192);
  Formats: array[0..3] of TDigestFormat = (dfMD5Sum, dfFSum, dfSFV, dfFSum);
var
  O: TMakeOptions;
  J1, J8: TChecksumJob;
  B1, B8: string;
  K: Integer;
  Lock1, Lock2: THandle;
  T: TChecksumThread;
  Md5: string;
begin
  WriteLn('--- several files at once: making lists');
  O := Default(TMakeOptions);
  O.Folder := Dir;
  O.BaseName := 'par';
  for K := 0 to High(Algos) do
  begin
    O.Algo := Algos[K];
    O.Format := Formats[K];
    J1 := MakeListWith(1, O, B1);
    J8 := MakeListWith(ManyThreads, O, B8);
    try
      Check((J1.Outcome = mkDone) and (J8.Outcome = mkDone) and (J1.Threads = 1) and (J8.Threads = ManyThreads) and
        (B1 <> '') and (B1 = B8) and (J8.BytesDone = J8.BytesTotal),
        HashNames[O.Algo] + ' list of ' + IntToStr(ParFiles) + ' files: 1 and ' + IntToStr(ManyThreads) +
        ' workers write the same list');
    finally
      J1.Free;
      J8.Free;
    end;
  end;
  // and the list is right, not just the same: one file against the engine's own MD5
  O.Algo := haMD5;
  O.Format := dfMD5Sum;
  J8 := MakeListWith(ManyThreads, O, B8);
  J8.Free;
  Check(FileMd5(Dir + ParName(150), Md5) and (Pos(Md5 + '  ' + StringReplace(ParName(150), '\', '/', [rfReplaceAll]),
    B8) > 0), '... and its checksums are right');

  // an unreadable file: the run fails on it, with either count, and on the first one when there are two
  Lock1 := LockOut(Dir + ParName(150));
  try
    J1 := MakeListWith(1, O, B1);
    J8 := MakeListWith(ManyThreads, O, B8);
    try
      Check((J1.Outcome = mkFailed) and (J8.Outcome = mkFailed) and (Pos(ParName(150), J8.ErrorText) > 0) and
        (J1.ErrorText = J8.ErrorText) and (J8.ListPath = '') and not FileExists(Dir + 'par.md5'),
        'an unreadable file fails the run the same way (' + J8.ErrorText + ')');
    finally
      J1.Free;
      J8.Free;
    end;
    // f40 is in p\d5, so f150 (p\d3) is the first in the list; f42 (p\d0) comes before both
    Lock2 := LockOut(Dir + ParName(42));
    try
      J1 := MakeListWith(1, O, B1);
      J8 := MakeListWith(ManyThreads, O, B8);
      try
        Check((J8.Outcome = mkFailed) and (Pos(ParName(42), J8.ErrorText) > 0) and (J1.ErrorText = J8.ErrorText),
          '... on the first of two in the list (' + J8.ErrorText + ')');
      finally
        J1.Free;
        J8.Free;
      end;
    finally
      CloseHandle(Lock2);
    end;
  finally
    CloseHandle(Lock1);
  end;

  // Cancel while the workers are reading
  O.Algo := haTiger192;
  O.Format := dfFSum;
  SysUtils.DeleteFile(Dir + 'par.tiger192');
  HashThreadsOverride := ManyThreads;
  J8 := TChecksumJob.Create(O, ScanFolder(O.Folder, True, O.BaseName));
  try
    T := TChecksumThread.Create(J8);
    try
      while (J8.BytesDone = 0) and not T.Finished do Sleep(1);
      J8.Cancel;
      T.WaitFor;
    finally
      T.Free;
    end;
    Check((J8.Outcome = mkCancelled) and (J8.ListPath = '') and not FileExists(Dir + 'par.tiger192') and
      (J8.BytesDone < J8.BytesTotal), 'Cancel stops the workers and writes no list (' +
      FormatSize(J8.BytesDone) + ' of ' + FormatSize(J8.BytesTotal) + ' read)');
  finally
    J8.Free;
    HashThreadsOverride := 0;
  end;
end;

type
  // cancels the check when the first BAD file is logged
  TCancelOnBad = class
    Engine: TOfflineCopy;
    Logged: string;
    procedure Log(const Msg: string);
  end;

procedure TCancelOnBad.Log(const Msg: string);
begin
  Logged := Logged + Msg + #10;
  if (Engine <> nil) and (Pos('  BAD: ', Msg) = 1) then Engine.Cancel;
end;

function CheckWith(Threads: Integer; const ListFile: string; out Items: TCheckItems; out Logged: string;
  CancelOnBad: Boolean): TCopyResult;
var
  C: TOfflineCopy;
  L: TCancelOnBad;
begin
  HashThreadsOverride := Threads;
  C := TOfflineCopy.Create(Settings, ExtractFilePath(ListFile), 'MD5');
  L := TCancelOnBad.Create;
  try
    if CancelOnBad then L.Engine := C;
    C.OnLog := L.Log;
    C.OnProgress := H.Progress;
    Result := C.CheckMd5(ListFile);
    Items := C.CheckItems;
    // the 'checking 302 files ...' line says how many are read at once when it is more than one
    Logged := WithoutLines(L.Logged, ': checking ');
  finally
    L.Free;
    C.Free;
    HashThreadsOverride := 0;
  end;
end;

// the first N items of A and B are the same (and both have N)
function SameItems(const A, B: TCheckItems; N: Integer): Boolean;
var
  I: Integer;
begin
  Result := (N > 0) and (N <= Length(A)) and (N <= Length(B));
  if Result then
    for I := 0 to N - 1 do
      if (A[I].Status <> B[I].Status) or (A[I].Path <> B[I].Path) or (A[I].Size <> B[I].Size) then Exit(False);
end;

// where file I of MakeParFiles is in a list (the lists are sorted by name); -1 if not there
function ItemOf(const Items: TCheckItems; I: Integer): Integer;
begin
  for Result := 0 to High(Items) do
    if Items[Result].Path = ParName(I) then Exit;
  Result := -1;
end;

function FirstWith(const Items: TCheckItems; S: TCheckStatus): Integer;
begin
  for Result := 0 to High(Items) do
    if Items[Result].Status = S then Exit;
  Result := -1;
end;

procedure TestParallelCheck(const Dir: string);
const
  ListAlgos: array[0..1] of THashAlgo = (haMD5, haSHA512);
var
  O: TMakeOptions;
  J: TChecksumJob;
  Body, L1, L8, Rep1, Rep8: string;
  I1, I8: TCheckItems;
  R1, R8: TCopyResult;
  Lock: THandle;
  K, N, Bad: Integer;
  ListFiles: array[0..1] of string;
begin
  WriteLn('--- several files at once: the MD5 check page');
  O := Default(TMakeOptions);
  O.Folder := Dir;
  O.BaseName := 'chk';
  O.Algo := haMD5;
  O.Format := dfFSum;
  J := MakeListWith(1, O, Body);
  J.Free;
  ListFiles[0] := Dir + 'chk.md5';
  O.Algo := haSHA512;
  J := MakeListWith(1, O, Body);
  J.Free;
  ListFiles[1] := Dir + 'chk.sha512';
  for K := 0 to 1 do
  begin
    R1 := CheckWith(1, ListFiles[K], I1, L1, False);
    R8 := CheckWith(ManyThreads, ListFiles[K], I8, L8, False);
    N := Length(I1);
    Check((R1 = crOk) and (R8 = crOk) and (N >= ParFiles) and (Length(I8) = N) and SameItems(I1, I8, N) and
      (L1 = L8) and (H.Last.BytesCopied = H.Last.BytesTotal) and (H.Last.FilesDone = N),
      ExtractFileName(ListFiles[K]) + ': 1 and ' + IntToStr(ManyThreads) + ' workers: all ' + IntToStr(N) +
      ' ok, same results');
  end;

  // spoil some, remove two, lock one
  SpoilFile(Dir + ParName(10));
  SpoilFile(Dir + ParName(120));
  SpoilFile(Dir + ParName(299));
  SysUtils.DeleteFile(Dir + ParName(11));
  SysUtils.DeleteFile(Dir + ParName(200));
  Lock := LockOut(Dir + ParName(150));
  try
    for K := 0 to 1 do
    begin
      R1 := CheckWith(1, ListFiles[K], I1, L1, False);
      R8 := CheckWith(ManyThreads, ListFiles[K], I8, L8, False);
      Rep1 := WithoutLines(CheckReportText(ListFiles[K], ListAlgos[K], I1, R1), 'Checked by ');
      Rep8 := WithoutLines(CheckReportText(ListFiles[K], ListAlgos[K], I8, R8), 'Checked by ');
      N := Length(I1);
      Check((R1 = crFailed) and (R8 = crFailed) and (N >= ParFiles) and (Length(I8) = N) and SameItems(I1, I8, N) and
        (CountStatus(I8, csBad) = 3) and (CountStatus(I8, csMissing) = 2) and (CountStatus(I8, csUnreadable) = 1) and
        (I8[ItemOf(I8, 150)].Status = csUnreadable) and (I8[ItemOf(I8, 11)].Status = csMissing) and
        (I8[ItemOf(I8, 299)].Status = csBad),
        ExtractFileName(ListFiles[K]) + ': changed, missing and unreadable files found the same way');
      Check((L1 = L8) and (Pos('  BAD: ' + ParName(299), L8) > 0) and (Rep1 = Rep8),
        '... logged in the same (list) order, and the same report');
    end;

    // cancelled on the first BAD file: the items up to it, the same with either count
    CheckWith(1, ListFiles[0], I1, L1, False);
    Bad := FirstWith(I1, csBad);
    R1 := CheckWith(1, ListFiles[0], I1, L1, True);
    R8 := CheckWith(ManyThreads, ListFiles[0], I8, L8, True);
    Check((Bad > 0) and (R1 = crCancelled) and (R8 = crCancelled) and (Length(I1) = Bad + 1) and
      (Length(I8) = Bad + 1) and SameItems(I1, I8, Bad + 1) and (I8[Bad].Status = csBad) and (L1 = L8),
      'cancelled at the first bad file (item ' + IntToStr(Bad) + '): both stop there, with the same results (' +
      IntToStr(Length(I8)) + ' items)');
  finally
    CloseHandle(Lock);
  end;
end;

{ Runs the checksum program as Exe /log=<file> /threads=N, hidden; its exit code, -1 if it did not end in a minute }
function RunProgram(const Exe, LogFile: string; Threads: Integer): Integer;
var
  SI: TStartupInfoW;
  PI: TProcessInformation;
  Cmd: string;
  Code: DWORD;
begin
  Result := -1;
  FillChar(SI, SizeOf(SI), 0);
  SI.cb := SizeOf(SI);
  SI.dwFlags := STARTF_USESHOWWINDOW;
  SI.wShowWindow := SW_SHOWMINNOACTIVE;
  Cmd := '"' + Exe + '" "/log=' + LogFile + '" /threads=' + IntToStr(Threads);
  UniqueString(Cmd);
  if not CreateProcessW(nil, PWideChar(Cmd), nil, nil, False, 0, nil, nil, SI, PI) then Exit;
  try
    if WaitForSingleObject(PI.hProcess, 60000) <> WAIT_OBJECT_0 then
    begin
      TerminateProcess(PI.hProcess, 9);
      Exit;
    end;
    if GetExitCodeProcess(PI.hProcess, Code) then Result := Integer(Code);
  finally
    CloseHandle(PI.hThread);
    CloseHandle(PI.hProcess);
  end;
end;

procedure TestParallelProgram(const Dir: string);
var
  O: TMakeOptions;
  J: TChecksumJob;
  Rep1, Rep8: string;
  E1, E8: Integer;
  Lock: THandle;
begin
  WriteLn('--- several files at once: the checksum program');
  if (StubExe = '') or not FileExists(StubExe) then
  begin
    WriteLn('  (no checksum program given - skipped)');
    Exit;
  end;
  O := Default(TMakeOptions);
  O.Folder := Dir;
  O.BaseName := 'prog';
  O.Algo := haSHA256;
  O.Format := dfFSum;
  O.MakeProgram := True;
  O.IconFile := Work + 'test.ico';               // made by TestMakeLists (this test exe has no icon of its own)
  HashThreadsOverride := ManyThreads;
  J := TChecksumJob.Create(O, ScanFolder(O.Folder, True, O.BaseName));
  try
    J.StubFile := StubExe;
    J.Run;
    Check(J.Outcome = mkDone, 'a checksum program made for ' + IntToStr(Length(J.Files)) + ' files (' +
      J.ErrorText + ')');
  finally
    J.Free;
    HashThreadsOverride := 0;
  end;
  E1 := RunProgram(Dir + 'prog.exe', Work + 'prog1.txt', 1);
  E8 := RunProgram(Dir + 'prog.exe', Work + 'prog8.txt', ManyThreads);
  Rep1 := WithoutLines(ReadUtf8(Work + 'prog1.txt'), ' tested, ');
  Rep8 := WithoutLines(ReadUtf8(Work + 'prog8.txt'), ' tested, ');
  Check((E1 = 0) and (E8 = 0) and (Rep8 <> '') and (Rep1 = Rep8) and (Pos('EVERY FILE APPEARS TO BE OK', Rep8) > 0),
    '1 and ' + IntToStr(ManyThreads) + ' workers: every file ok, the same report (exit ' + IntToStr(E1) + ', ' +
    IntToStr(E8) + ')');

  SpoilFile(Dir + ParName(20));
  SysUtils.DeleteFile(Dir + ParName(21));
  Lock := LockOut(Dir + ParName(160));
  try
    E1 := RunProgram(Dir + 'prog.exe', Work + 'prog1.txt', 1);
    E8 := RunProgram(Dir + 'prog.exe', Work + 'prog8.txt', ManyThreads);
  finally
    CloseHandle(Lock);
  end;
  Rep1 := WithoutLines(ReadUtf8(Work + 'prog1.txt'), ' tested, ');
  Rep8 := WithoutLines(ReadUtf8(Work + 'prog8.txt'), ' tested, ');
  Check((E1 = 1) and (E8 = 1) and (Rep1 = Rep8) and
    (Pos('FAILED'#9'SHA256'#9 + ParName(20), Rep8) > 0) and (Pos('MISSING'#9'SHA256'#9 + ParName(21), Rep8) > 0) and
    (Pos('ERROR'#9'SHA256'#9 + ParName(160), Rep8) > 0),
    '... changed, missing and unreadable files: the same report, in list order (exit ' + IntToStr(E1) + ', ' +
    IntToStr(E8) + ')');
end;

// the lines of Text that start with two spaces (a run's per-file log lines - the others name the drive's folder)
function FileLines(const Text: string): string;
var
  L: TStringList;
  I: Integer;
begin
  L := TStringList.Create;
  try
    L.Text := Text;
    for I := L.Count - 1 downto 0 do
      if Copy(L[I], 1, 2) <> '  ' then L.Delete(I);
    Result := L.Text;
  finally
    L.Free;
  end;
end;

{ Recording checksums after a copy and Verify drive: two fake drives get the same copy, one with 1 worker and one
  with 8; their checksum lists must be the same, and Verify must find the same bad files }
procedure TestParallelDrive(const Dir: string);
var
  S: TBackupSettings;
  DA, DB, L, CrcA, CrcB, Md5A, Md5B, LogA, LogB: string;
  RA, RB: TCopyResult;
begin
  WriteLn('--- several files at once: recording checksums after a copy, and Verify drive');
  L := SourceLetter(Work);
  S := Settings;
  S.Sources := nil;
  S.Exclude := nil;
  AddSource(S, Dir + 'p', True);
  DA := Work + 'PARDRIVE1\';
  DB := Work + 'PARDRIVE8\';
  SetUpDrive(DA, S);
  SetUpDrive(DB, S);
  HashThreadsOverride := 1;
  RA := RunCopyOn(S, DA, True);
  HashThreadsOverride := ManyThreads;
  RB := RunCopyOn(S, DB, True);
  HashThreadsOverride := 0;
  CrcA := ReadUtf8(DA + '_checksums\' + L + '-mirror\p.crc');
  CrcB := ReadUtf8(DB + '_checksums\' + L + '-mirror\p.crc');
  // without the header's comment lines (one has the time, to the second)
  Md5A := WithoutLines(ReadUtf8(DA + L + '-mirror\p.md5'), '; ');
  Md5B := WithoutLines(ReadUtf8(DB + L + '-mirror\p.md5'), '; ');
  Check((RA = crOk) and (RB = crOk) and (CrcA <> '') and (CrcA = CrcB) and (Md5A <> '') and (Md5A = Md5B) and
    (Pos(#9 + Copy(ParName(150), 3, MaxInt), CrcB) > 0) and (H.LastHash.HashFiles = ParFiles),
    'copies with 1 and ' + IntToStr(ManyThreads) + ' workers record the same checksums (' +
    IntToStr(H.LastHash.HashFiles) + ' files)');
  // the drive holds p\..., so ParName's 'p\' is the mirror folder's own name
  SpoilFile(DA + L + '-mirror\' + ParName(30));
  SpoilFile(DB + L + '-mirror\' + ParName(30));
  SpoilFile(DA + L + '-mirror\' + ParName(250));
  SpoilFile(DB + L + '-mirror\' + ParName(250));
  H.LogText := '';
  HashThreadsOverride := 1;
  RA := RunVerifyOn(DA);
  LogA := FileLines(H.LogText);
  H.LogText := '';
  HashThreadsOverride := ManyThreads;
  RB := RunVerifyOn(DB);
  LogB := FileLines(H.LogText);
  HashThreadsOverride := 0;
  Check((RA = crFailed) and (RB = crFailed) and (LogA = LogB) and (Pos('BAD: ' + L + '-mirror\' + ParName(30), LogB) > 0)
    and (Pos('BAD: ' + L + '-mirror\' + ParName(250), LogB) > 0) and (H.Last.FilesDone = ParFiles) and
    (H.Last.BytesCopied = H.Last.BytesTotal),
    'Verify with 1 and ' + IntToStr(ManyThreads) + ' workers finds the same 2 bad files, logged in the same order');
  CrcA := ReadUtf8(DA + '_checksums\' + L + '-mirror\p.crc');
  CrcB := ReadUtf8(DB + '_checksums\' + L + '-mirror\p.crc');
  Check((CrcA = CrcB) and (Pos(#9 + Copy(ParName(30), 3, MaxInt), CrcB) = 0) and
    (Pos(#9 + Copy(ParName(31), 3, MaxInt), CrcB) > 0), '... and leaves the same checksum lists');
end;

{ Paths over Windows' old 260-character limit, and a drive's hidden system folders: making a list, the MD5 check, and a
  copy with its recorded checksums and Verify drive }
procedure TestLongPaths;
var
  Dir, Rel, D: string;
  I: Integer;
  L: TMakeFiles;
  O: TMakeOptions;
  J: TChecksumJob;
  Items: TCheckItems;
  R: TCopyResult;
  S: TBackupSettings;
begin
  WriteLn('--- long paths and hidden system folders');
  Dir := Work + 'longpath\src\';
  ForceDirectories(Dir);
  Rel := '';
  for I := 1 to 6 do
  begin
    Rel := Rel + StringOfChar(Char(Ord('a') + I), 50) + '\';
    CreateDirectoryW(PWideChar(ExtendedPath(Dir + Rel)), nil);
  end;
  WriteFileW(ExtendedPath(Dir + Rel + 'deep.txt'), 'deep down');
  WriteFileW(Dir + 'short.txt', 'short');
  CreateDirectoryW(PWideChar(Dir + '$RECYCLE.BIN'), nil);
  WriteFileW(Dir + '$RECYCLE.BIN\deleted.txt', 'in the bin');
  SetFileAttributesW(PWideChar(Dir + '$RECYCLE.BIN'), FILE_ATTRIBUTE_HIDDEN or FILE_ATTRIBUTE_SYSTEM);
  L := ScanFolder(Dir, True, 'checksum');
  Check((Length(L) = 2) and (Length(Dir + L[0].RelName) > 300) and (L[1].RelName = 'short.txt'),
    'the folder scan finds a file with a ' + IntToStr(Length(Dir + Rel + 'deep.txt')) +
    '-character path and leaves out $RECYCLE.BIN');
  O := Default(TMakeOptions);
  O.Folder := Dir;
  O.BaseName := 'checksum';
  O.Algo := haMD5;
  O.Format := dfFSum;
  J := MakeList(O, '');
  try
    Check(J.Outcome = mkDone, '... and makes its list (' + J.ErrorText + ')');
  finally
    J.Free;
  end;
  Check((RunCheckMd5(Dir + 'checksum.md5', Items) = crOk) and (Length(Items) = 2), '... which the MD5 check reads');
  SysUtils.DeleteFile(Dir + 'checksum.md5');
  // a copy (robocopy copies long paths), its recorded checksums and Verify drive
  S := Settings;
  S.Sources := nil;
  S.Exclude := nil;
  AddSource(S, Work + 'longpath\src', True);
  D := Work + 'LONGDRIVE\';
  SetUpDrive(D, S);
  R := RunCopyOn(S, D, True);
  Check((R = crOk) and (H.LastHash.HashFiles >= 2) and
    (Pos(#9 + Rel + 'deep.txt', ReadUtf8(D + '_checksums\' + SourceLetter(Work) + '-mirror\src.crc')) > 0),
    'a copy records the long-path file''s checksum (' + CopyResultText(R) + ')');
  H.LogText := '';
  R := RunVerifyOn(D);
  Check((R = crOk) and (Pos('could not read', H.LogText) = 0), 'Verify drive reads it (' + CopyResultText(R) + ')');
end;

procedure TestParallel;
var
  Dir: string;
begin
  Dir := Work + 'parallel\';
  MakeParFiles(Dir);
  WriteLn('--- several files at once: this PC has ', LogicalCpuCount, ' logical processors; the work folder gets ',
    HashThreadCount(Dir), ' workers');
  TestParallelLists(Dir);
  TestParallelDrive(Dir);
  TestParallelCheck(Dir);
  // the check above changed and removed files: start the program's test from fresh ones
  MakeParFiles(Dir);
  TestParallelProgram(Dir);
  TestLongPaths;
end;
